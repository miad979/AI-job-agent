# Loaded only by `vite --mode pages` (npm run build:pages / dev:pages / deploy). Contains no secrets.
# local = no server: the app runs entirely in the visitor's browser and keeps its data in localStorage.
VITE_BACKEND=local
# To make the Pages site talk to a hosted Orbit API instead, remove the line above and set:
# VITE_API_URL=https://your-orbit-api.example.com
# (then add the Pages origin to CORS_ORIGINS on that server)
