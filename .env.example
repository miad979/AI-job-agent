PORT=8787
# remotive = live remote jobs (free public API, no key). demo = 3 built-in sample jobs.
JOB_SOURCE=remotive
# manual = "Approve & apply" opens the real listing; you confirm in Orbit once you applied.
# mock   = marks Submitted immediately (for demos/tests only).
SUBMISSION_MODE=manual
# Where the SQLite file lives
DB_PATH=data/orbit.db
# AI drafting: groq | ollama | none (none = deterministic local template, still resume-only facts)
AI_PROVIDER=none
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
